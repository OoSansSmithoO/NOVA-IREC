{
  "name": "nova-irec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8090",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:links": "node scripts/check-public-links.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:links",
    "preview": "vite preview --host 0.0.0.0 --port 8090"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "postprocessing": "6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
